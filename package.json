{
  "name": "@bozz/routeros",
  "version": "0.0.0-dev",
  "description": "Modern protocol-correct RouterOS Binary API SDK for Node.js and TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "examples", "README.md", "LICENSE", "NOTICE", "docs"],
  "sideEffects": false,
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "test:stress": "node --import tsx --test test/tag-leak-stress.test.ts test/listen-soak.test.ts test/concurrency.test.ts",
    "test:conformance": "node --import tsx --test test/conformance/routeros.integration.test.ts",
    "check": "npm run typecheck && npm test && npm run test:stress && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mikrotik",
    "routeros",
    "routerboard",
    "api",
    "typescript",
    "nodejs",
    "network-automation"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bozz33/-bozz-routeros.git"
  },
  "bugs": {
    "url": "https://github.com/bozz33/-bozz-routeros/issues"
  },
  "homepage": "https://github.com/bozz33/-bozz-routeros#readme",
  "publishConfig": {
    "access": "public"
  }
}
